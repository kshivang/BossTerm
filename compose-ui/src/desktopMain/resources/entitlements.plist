<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JVM to run with JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow loading unsigned libraries (for JNA/PTY support) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- CRITICAL: Disable library validation for JVM native libraries -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow dyld environment variables -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Allow debugging (needed for JVM) -->
    <key>com.apple.security.cs.debugger</key>
    <true/>

    <!-- Microphone for Boss Calling's in-app voice call (paired with
         NSMicrophoneUsageDescription in Info.plist) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Inherit the user's login environment -->
    <key>com.apple.security.inherit</key>
    <true/>

    <!-- Network access for terminal operations -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- File access (user-selected files) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
